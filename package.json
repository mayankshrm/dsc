{
  "name": "dsc",
  "version": "0.1.0",
  "private": true,
  "description": "Delhi Skating Community website monorepo",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
